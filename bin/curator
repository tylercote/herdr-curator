#!/usr/bin/env python3
"""Entrypoint for the herdr-curator plugin. Stdlib-only; Python >= 3.9."""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

from curator.__main__ import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
